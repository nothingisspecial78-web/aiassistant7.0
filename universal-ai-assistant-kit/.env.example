# Universal AI Assistant Kit — Environment Variables
# Copy needed keys to your host app's .env file (never commit real secrets).

# --- LLM Providers (at least one key enables live AI chat; falls back cleanly when omitted) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: Kit Runtime Defaults ---
UAI_APP_ID=default
UAI_APP_NAME=AI Assistant
UAI_PROFILES_DIR=./profiles
UAI_DATA_DIR=./data
UAI_CORS_ORIGINS=*
UAI_AUTH_MODE=hybrid
UAI_JWT_SECRET=

# --- Optional: Billing & Payments (disabled by default; enable only if billing.mode = 'credits' | 'subscription') ---
UAI_BILLING_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional: Supabase Persistence ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
