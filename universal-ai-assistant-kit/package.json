{
  "name": "@universal-ai-assistant/kit",
  "version": "1.0.0",
  "description": "Universal, self-contained drop-in AI Assistant module (3D Avatar, Co-Browser Guide, SSE Chat, RAG, Multi-Format Exports, File Import Validation, Voice TTS/STT, Scoped Tools & Optional Billing).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs"
    },
    "./web-component": "./dist/web-component.js",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "profiles",
    "docs",
    "examples",
    "README.md",
    "00_READ_ME_FIRST_FOR_AI_AGENT.md",
    "OWNER_QUICK_START_ML.md",
    "FEATURES.md",
    "features.manifest.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build-kit.mjs",
    "verify": "node scripts/verify-kit.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@google/genai": "^3.3.0",
    "cors": "^2.8.6",
    "docx": "^9.15.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.57.0",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "^6.5.438",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
